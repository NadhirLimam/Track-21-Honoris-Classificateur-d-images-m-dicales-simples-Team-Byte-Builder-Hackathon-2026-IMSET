# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas — free cloud database, no install required
# Sign up at https://cloud.mongodb.com, create a free M0 cluster, then paste your connection string here
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/medvision

# JWT
JWT_SECRET=medvision-hackathon-2026-secret-key
JWT_EXPIRES_IN=8h

# Gemini API — free key at https://aistudio.google.com/apikey (no credit card)
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
