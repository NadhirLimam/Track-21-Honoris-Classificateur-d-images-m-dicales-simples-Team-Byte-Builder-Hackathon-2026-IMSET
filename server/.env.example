# Server
PORT=5000
NODE_ENV=development

# MongoDB — choose one:
MONGO_URI=mongodb://localhost:27017/medvision
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/medvision

# JWT
JWT_SECRET=medvision-hackathon-2026-secret-key
JWT_EXPIRES_IN=8h

# Gemini API — free key at https://aistudio.google.com/apikey (no credit card)
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
